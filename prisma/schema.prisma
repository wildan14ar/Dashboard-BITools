generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  fullName     String?
  avatar       String?
  userName     String  @unique
  email        String  @unique
  passwordHash String

  isSuperAdmin       Boolean             @default(false)
  userRoles          UserRole[]
  biDashboards       BiDashboard[]
  biDashboardMembers BiDashboardMember[]
  biDataSets         BiDataSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Role model ---
model Role {
  id          String  @id @default(uuid()) // Changed from roleId
  name        String  @unique
  description String?
  isPublic    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

// --- Role Permission Catalog ---
model RolePermission {
  id          String  @id @default(ulid())
  action      String  @unique // e.g., "users:view"
  label       String // e.g., "View Users"
  description String?

  roles Role[] // Implicit M-N relation with Role

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum BiRole {
  VIEWER
  EDITOR
}

model BiFolder {
  id         String        @id @default(cuid())
  name       String
  parentId   String?       @map("parent_id")
  parent     BiFolder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   BiFolder[]    @relation("FolderTree")
  dashboards BiDashboard[]
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("bi_folders")
}

model BiDashboard {
  id          String              @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean             @default(false) @map("is_public")
  folderId    String?             @map("folder_id")
  folder      BiFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  panels      BiPanel[]
  members     BiDashboardMember[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User?               @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_dashboards")
}

model BiDashboardMember {
  id          String      @id @default(cuid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        BiRole      @default(VIEWER)

  @@unique([dashboardId, userId])
  @@map("bi_dashboard_members")
}

model BiDataSet {
  id          String    @id @default(cuid())
  name        String
  sql         String
  description String?
  isPublic    Boolean   @default(false) @map("is_public")
  panels      BiPanel[]
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_data_sets")
}

model BiPanel {
  id          String      @id @default(cuid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  dataSetId   String?     @map("data_set_id")
  dataSet     BiDataSet?  @relation(fields: [dataSetId], references: [id], onDelete: SetNull)
  title       String
  chartType   String      @default("table")
  config      Json?
  x           Int         @default(0)
  y           Int         @default(0)
  w           Int         @default(6)
  h           Int         @default(4)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([dashboardId])
  @@map("bi_panels")
}
