generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  fullName     String?
  avatar       String?
  userName     String  @unique
  email        String  @unique
  passwordHash String

  isSuperAdmin       Boolean             @default(false)
  userRoles          UserRole[]
  biDashboards       BiDashboard[]
  biDashboardMembers BiDashboardMember[]
  biDatasets         BiDataset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Role model ---
model Role {
  id          String  @id @default(uuid()) // Changed from roleId
  name        String  @unique
  description String?
  isPublic    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

// --- Role Permission Catalog ---
model RolePermission {
  id          String  @id @default(ulid())
  action      String  @unique // e.g., "users:view"
  label       String // e.g., "View Users"
  description String?

  roles Role[] // Implicit M-N relation with Role

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum BiRole {
  VIEWER
  EDITOR
}

model BiDashboard {
  id          String              @id @default(cuid())
  name        String
  description String?
  tags        String[]            @map("tags")
  isPublic    Boolean             @default(false) @map("is_public")
  panels      BiPanel[]
  filters     BiFilter[]
  members     BiDashboardMember[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User?               @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_dashboards")
}

model BiDashboardMember {
  id          String      @id @default(cuid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        BiRole      @default(VIEWER)

  @@unique([dashboardId, userId])
  @@map("bi_dashboard_members")
}

model BiDataset {
  id          String    @id @default(cuid())
  name        String
  sql         String
  description String?
  isPublic    Boolean   @default(false) @map("is_public")
  sourceId    String?   @map("source_id")
  source      BiSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  panels      BiPanel[]
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_datasets")
}

model BiSource {
  id       String      @id @default(cuid())
  name     String
  type     String      @default("postgresql")
  config   Json?
  datasets BiDataset[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("bi_sources")
}

model BiPanel {
  id          String      @id @default(cuid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  dataSetId   String?     @map("data_set_id")
  dataSet     BiDataset? @relation(fields: [dataSetId], references: [id], onDelete: SetNull)
  title       String
  chartType   String      @default("table")
  config      Json?
  x           Int         @default(0)
  y           Int         @default(0)
  w           Int         @default(6)
  h           Int         @default(4)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([dashboardId])
  @@map("bi_panels")
}

model BiFilter {
  id          String      @id @default(cuid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name        String
  label       String
  type        String      @default("text")
  config      Json?
  position    Int         @default(0)

  @@map("bi_filters")
}
