// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// User & Access Control
// ============================================================================
model User {
  id       String @id @default(ulid())
  email    String @unique
  username String @unique
  fullname String
  avatar   String?
  quote    String?

  phone      String?
  address    String?
  birthDate  DateTime?
  birthPlace String?
  gender     Gender?

  isActive     Boolean @default(true)
  isPublic     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  isEmailVerified Boolean        @default(false)

  userRoles UserRole[]

  // Better Auth
  sessions Session[]
  accounts Account[]

  // Global
  notifications Notification[]
  activityLogs  ActivityLog[]
  apiKeys       ApiKey[]
  attachments   Attachment[]
  calendarAssignments CalendarAssignment[]
  calendarsCreated Calendar[]

  // BI Domain (opposite sides of Bi* user relations)
  biDashboards        BiDashboard[]
  biDashboardMembers  BiDashboardMember[]
  biDatasets          BiDataset[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
}

// Better Auth core models (managed by prismaAdapter)
// Nilai harus lowercase: Better Auth menulis providerId sebagai string lowercase
enum AccountProvider {
  credential
  google
  github
}

enum Gender {
  MALE
  FEMALE
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(ulid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. "blog.create", "user.login", "drive.upload"
  entity    String // e.g. "Blog", "User", "DriveFile"
  entityId  String? // ID of the affected entity
  metadata  Json? // Additional context (changes, request info, etc.)
  ip        String? // Client IP address
  userAgent String? // Client user agent
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Account {
  id                    String          @id
  // Nullable: Better Auth tidak menulis kolom ini saat membuat Account
  // (signup/login); diisi manual hanya untuk kredensial lokal ("local:credential").
  issuer                String?
  providerId            AccountProvider
  accountId             String
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // ponytail: unique pada issuer+accountId — konvensi Better Auth v1.7
  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id          String  @id @default(ulid())
  name        String  @unique
  description String?

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(ulid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

model RolePermission {
  id          String  @id @default(ulid())
  action      String // e.g., "users:read"
  label       String // e.g., "Users - read"
  description String?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([roleId])
  @@index([action])
}

model Attachment {
  id     String @id @default(ulid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  filePath String
  fileType String
  fileSize Int
  fileHash String

  // Backend penyimpanan: "s3" (object storage) atau "db" (fallback Bytes).
  storage String @default("db")
  // Isi file mentah — hanya dipakai saat storage = "db".
  data Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ApiKey {
  id      String @id @default(ulid())
  name    String
  prefix  String // 8 chars pertama token untuk identifikasi di UI & lookup
  keyHash String @unique // argon2id(salt + raw key)
  keySalt String // salt acak per-key, dipakai saat verifikasi

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hak akses key = permission user pemilik saat request (bukan scope per-key).
  isActive   Boolean  @default(true)
  isMCP      Boolean   @default(false)
  isRestfull Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  usageCount Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([prefix])
  @@index([keyHash])
}

model Notification {
  id     String  @id @default(ulid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  body   String?
  link   String?
  isRead Boolean @default(false)
  type   String  @default("mention")

  // Relasi langsung opsional ke Calendar (pengingat / broadcast per event).
  calendarId String?
  calendar   Calendar? @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([calendarId])
}

model Calendar {
  id          String    @id @default(ulid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  color       String    @default("#3B82F6")
  isNotify    Boolean   @default(false)
  isHoliday   Boolean   @default(false)
  repeatType  String    @default("none")
  repeatDays  String    @default("")
  notes       String    @default("[]")

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  assignments CalendarAssignment[]

  // Notifikasi terkait (pengingat otomatis / broadcast per event).
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

model CalendarAssignment {
  id         String   @id @default(ulid())
  calendarId String
  userId     String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([calendarId, userId])
  @@index([userId])
}

// ============================================================================
// BI Domain — IDs diseragamkan ke ULID ala PortoNext
// ============================================================================
enum BiRole {
  VIEWER
  EDITOR
}

model BiDashboard {
  id          String              @id @default(ulid())
  name        String
  description String?
  // Postgres mendukung list primitif (text[]) secara native.
  tags        String[]            @map("tags")
  isPublic    Boolean             @default(false) @map("is_public")
  panels      BiPanel[]
  filters     BiFilter[]
  members     BiDashboardMember[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User?               @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_dashboards")
}

model BiDashboardMember {
  id          String      @id @default(ulid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        BiRole      @default(VIEWER)

  @@unique([dashboardId, userId])
  @@map("bi_dashboard_members")
}

model BiDataset {
  id          String    @id @default(ulid())
  name        String
  sql         String
  description String?
  isPublic    Boolean   @default(false) @map("is_public")
  sourceId    String?   @map("source_id")
  source      BiSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  panels      BiPanel[]
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_datasets")
}

model BiSource {
  id        String      @id @default(ulid())
  name      String
  type      String      @default("postgresql")
  config    Json?
  datasets  BiDataset[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("bi_sources")
}

model BiPanel {
  id          String     @id @default(ulid())
  dashboardId String     @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  dataSetId   String?    @map("data_set_id")
  dataSet     BiDataset? @relation(fields: [dataSetId], references: [id], onDelete: SetNull)
  title       String
  chartType   String     @default("table")
  config      Json?
  x           Int        @default(0)
  y           Int        @default(0)
  w           Int        @default(6)
  h           Int        @default(4)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([dashboardId])
  @@map("bi_panels")
}

model BiFilter {
  id          String      @id @default(ulid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name        String
  label       String
  type        String      @default("text")
  config      Json?
  position    Int         @default(0)

  @@map("bi_filters")
}