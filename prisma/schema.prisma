generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// User & Access Control — pola PortoNext (Better Auth + RBAC)
// Naming mengikuti Porto: fullname/username lowercase.
// passwordHash dipertahankan opsional untuk migrasi bcrypt -> Account.
// ============================================================================
model User {
  id       String  @id @default(ulid())
  email    String  @unique
  username String  @unique
  fullname String?
  avatar   String?
  quote    String?

  // Deprecated: dipakai NextAuth lama. Password baru di Account via setCredentialPassword.
  passwordHash String?

  isActive        Boolean @default(true)
  isPublic        Boolean @default(true)
  isSuperAdmin    Boolean @default(false)
  isEmailVerified Boolean @default(false)

  userRoles UserRole[]

  // Better Auth
  sessions Session[]
  accounts Account[]

  // Global
  notifications Notification[]
  activityLogs  ActivityLog[]

  // BI domain
  biDashboards       BiDashboard[]
  biDashboardMembers BiDashboardMember[]
  biDatasets         BiDataset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Better Auth core models (managed by prismaAdapter)
// Nilai harus lowercase: Better Auth menulis providerId sebagai string lowercase
enum AccountProvider {
  credential
  google
  github
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String          @id
  issuer                String
  providerId            AccountProvider
  accountId             String
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// --- Role model ---
model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isPublic    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

// --- Role Permission Catalog ---
model RolePermission {
  id          String  @id @default(ulid())
  action      String  @unique // e.g., "users:view"
  label       String // e.g., "View Users"
  description String?

  roles Role[] // Implicit M-N relation with Role

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ============================================================================
// Audit — pola PortoNext, fire-and-forget via lib/activity.ts
// ============================================================================
model Notification {
  id     String  @id @default(ulid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  body   String?
  link   String?
  isRead Boolean @default(false)
  type   String  @default("mention")

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ActivityLog {
  id        String  @id @default(ulid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. "bi.dashboard.create", "user.login"
  entity    String // e.g. "BiDashboard", "User"
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================================
// BI Domain — IDs diseragamkan ke ULID ala PortoNext
// ============================================================================
enum BiRole {
  VIEWER
  EDITOR
}

model BiDashboard {
  id          String              @id @default(ulid())
  name        String
  description String?
  tags        String[]            @map("tags")
  isPublic    Boolean             @default(false) @map("is_public")
  panels      BiPanel[]
  filters     BiFilter[]
  members     BiDashboardMember[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User?               @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_dashboards")
}

model BiDashboardMember {
  id          String      @id @default(ulid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        BiRole      @default(VIEWER)

  @@unique([dashboardId, userId])
  @@map("bi_dashboard_members")
}

model BiDataset {
  id          String    @id @default(ulid())
  name        String
  sql         String
  description String?
  isPublic    Boolean   @default(false) @map("is_public")
  sourceId    String?   @map("source_id")
  source      BiSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  panels      BiPanel[]
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  @@map("bi_datasets")
}

model BiSource {
  id        String      @id @default(ulid())
  name      String
  type      String      @default("postgresql")
  config    Json?
  datasets  BiDataset[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("bi_sources")
}

model BiPanel {
  id          String     @id @default(ulid())
  dashboardId String     @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  dataSetId   String?    @map("data_set_id")
  dataSet     BiDataset? @relation(fields: [dataSetId], references: [id], onDelete: SetNull)
  title       String
  chartType   String     @default("table")
  config      Json?
  x           Int        @default(0)
  y           Int        @default(0)
  w           Int        @default(6)
  h           Int        @default(4)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([dashboardId])
  @@map("bi_panels")
}

model BiFilter {
  id          String      @id @default(ulid())
  dashboardId String      @map("dashboard_id")
  dashboard   BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name        String
  label       String
  type        String      @default("text")
  config      Json?
  position    Int         @default(0)

  @@map("bi_filters")
}
