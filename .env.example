# Dashboard (Next.js)
DATABASE_URL=postgresql://fycuser:fycpassword@localhost:5432/fycdb

# Better Auth (migrasi dari NextAuth — pola PortoNext)
# AUTH_SECRET lama tetap dibaca sebagai fallback BETTER_AUTH_SECRET
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
BETTER_AUTH_TRUSTED_ORIGINS="*.trycloudflare.com,*.ngrok-free.app"
# Dev tunnel: host yang diizinkan memuat HMR/chunks Next.js (boleh wildcard).
# Default sudah mencakup trycloudflare + ngrok; isi bila pakai domain lain.
ALLOWED_DEV_ORIGINS="*.trycloudflare.com,*.ngrok-free.app"
AUTH_SECRET=your_secret_key
AUTH_TRUST_HOST=true
QUERY_ENGINE_HOST=localhost:50051

# Seed users — kredensial akun awal. JANGAN pakai default di production.
SEED_ADMIN_EMAIL="admin@bi.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_PASSWORD="password123"
SEED_USER_EMAIL="user@bi.com"
SEED_USER_USERNAME="user"
SEED_USER_NAME="Regular User"
SEED_USER_PASSWORD="user123"

# Engine (Python)
QUERY_ENGINE_PORT=50051
REDIS_URL=redis://localhost:6379
QUERY_CACHE_TTL_SEC=300
QUERY_CACHE_STALE_WINDOW_SEC=600

# Cron cache warmer (opsional): POST /api/cron/refresh dengan header x-cron-secret.
# Contoh cron harian jam 6 pagi:
# 0 6 * * * curl -s -X POST -H "x-cron-secret: $CRON_SECRET" http://localhost:3000/api/cron/refresh
CRON_SECRET="your-cron-secret-here"
