# ─────────────────────────────────────────────────────────────────────────────
# Salin file ini jadi `.env`, lalu isi dengan nilai Anda.
#   cp .env.example .env
# Generate secret: openssl rand -base64 32
# JANGAN commit `.env` — sudah masuk .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose memakai POSTGRES_* di bawah untuk membuat service `db`, lalu
# compose menyusun DATABASE_URL untuk container app. Isi keduanya bila memakai
# compose; kalau menjalankan Postgres sendiri, cukup pakai DATABASE_URL saja.
#
# SQLite (dev di luar Docker) — adapter dipilih otomatis dari prefix `file:`
# DATABASE_URL="file:./prisma/dev.db"
#
# PostgreSQL (prod / compose) — prefix `postgresql:` memakai `pg` pool.
# TLS dikontrol penuh oleh connection string; kode tidak menambahkan parameter
# sslmode sendiri. Tambahkan `?sslmode=verify-full` untuk managed Postgres
# (atau `?sslmode=disable` untuk Postgres lokal tanpa TLS).
DATABASE_URL="postgresql://bi:bi-change-me@localhost:5432/bi?sslmode=disable"

# Kredensial service `db` di docker-compose.yml (dipakai juga untuk seed).
# WAJIB diganti di production — compose menolak start bila kosong.
POSTGRES_USER="bi"
POSTGRES_PASSWORD="bi-change-me"
POSTGRES_DB="bi"

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_URL="http://localhost:3000"
# WAJIB diganti di production.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Origins tambahan (comma-separated) untuk tunnel/dev server.
BETTER_AUTH_TRUSTED_ORIGINS="*.trycloudflare.com,*.ngrok-free.app"

# Toggle registrasi publik. "false" → /register redirect ke /login.
NEXT_PUBLIC_ALLOW_REGISTER="true"

# OAuth (opsional — isi client id/secret dari provider masing-masing)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_ENABLE_GITHUB_AUTH="false"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Rate limit (edge, in-memory — single instance) ───────────────────────────
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"

# Rate limit khusus endpoint run query BI.
RUN_RATE_LIMIT_MAX="30"
RUN_RATE_LIMIT_WINDOW_MS="60000"

# ── Query engine (gRPC) ──────────────────────────────────────────────────────
# Host:port dari `engine/` (default port 50051).
# Kalau engine jalan di container terpisah, isi nama service/host-nya.
QUERY_ENGINE_HOST="localhost:50051"

# Batas default eksekusi query.
QUERY_MAX_ROWS="1000"
QUERY_TIMEOUT_SEC="30"

# Folder data bersama antara dashboard & engine (upload file CSV/XLSX).
# Dibuat otomatis bila belum ada.
DATA_DIR="./data"
UPLOADS_MAX_BYTES="10485760"

# ── Attachment / storage ─────────────────────────────────────────────────────
# Batas ukuran upload attachment (bytes, default 10 MB).
ATTACHMENTS_MAX_SIZE="10485760"

# Backend S3-compatible (opsional). Kosong = fallback simpan di DB.
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_FORCE_PATH_STYLE="true"

# ── Docker Compose (opsional) ────────────────────────────────────────────────
# Override port host bila ada yang sudah memakai 3000/5432/6379/50051.
# Semua opsional — compose punya default.
# APP_PORT="3000"
# POSTGRES_PORT="5432"
# REDIS_PORT="6379"
# ENGINE_PORT="50051"

# ─────────────────────────────────────────────────────────────────────────────
# Query engine (engine/src/config.py) — dibaca saat `uv run python -m src.server`
# Bisa diisi di file .env yang sama (engine memanggil load_dotenv) atau via env
# sistem. Semua opsional.
#
# Port gRPC engine (default 50051).
# QUERY_ENGINE_PORT="50051"
#
# Cache schema + hasil query. Kosong/tidak hidup = engine tetap serve tanpa cache.
# REDIS_URL="redis://localhost:6379"
#
# Batasi schema yang diintrospeksi (comma-separated). Kosong = semua schema
# non-sistem. WAJIB diisi bila DB punya banyak schema, karena view katalog
# `information_schema` sangat lambat (~1,7s per objek).
# INTROSPECT_SCHEMAS="public"
#
# Pengaman agar introspeksi tidak meledak pada DB besar (default 500).
# INTROSPECT_MAX_OBJECTS="500"
#
# Connection pool & batas ukuran.
# DB_POOL_SIZE="5"
# DB_MAX_OVERFLOW="10"
# FETCH_MAX_BYTES="524288000"
# QUERY_CACHE_MAX_BYTES="5242880"
# ─────────────────────────────────────────────────────────────────────────────
